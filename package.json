{
  "name": "barbarian-lm",
  "private": true,
  "version": "0.1.0",
  "description": "Barbarian LM: a browser game that shows how language models work",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dungeon": "node tools/run.mjs tools/showDungeon.ts",
    "measure:dungeons": "node tools/run.mjs tools/measureDungeons.ts",
    "measure:compass": "node tools/run.mjs tools/measureCompass.ts",
    "measure:model": "node tools/run.mjs tools/measureModel.ts",
    "measure:teachers": "node tools/run.mjs tools/measureTeachers.ts",
    "measure:training": "node tools/run.mjs tools/measureTraining.ts",
    "measure:events": "node tools/run.mjs tools/measureEvents.ts",
    "measure:corrected": "node tools/run.mjs tools/measureCorrected.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
